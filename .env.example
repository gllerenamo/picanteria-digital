# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.

# PostgreSQL de Docker Compose (publicado en el puerto 5433 del host).
POSTGRES_USER=picanteria
POSTGRES_PASSWORD=cambia-esta-clave

# Conexiones usadas por la API y las pruebas cuando se ejecutan fuera de Docker.
DATABASE_URL=postgresql://picanteria:cambia-esta-clave@localhost:5433/picanteria
DATABASE_URL_TEST=postgresql://picanteria:cambia-esta-clave@localhost:5433/picanteria_test

# API
PORT=3000
# false en desarrollo local (http); true en producción (https).
COOKIE_SECURE=false

# Administrador inicial que crea la semilla si no existe ninguno.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=cambia-esta-clave
